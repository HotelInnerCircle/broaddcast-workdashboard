<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and up ask separately about cloud backup and about device-to-device
  transfer, and allowBackup="false" only answers the first. Both are refused here:
  the app's private data is a signed-in session, which should be obtained by
  signing in and not by restoring it onto another phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
