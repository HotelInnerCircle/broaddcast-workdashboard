# --- Core ---
MONGODB_URI=mongodb://localhost:27017/workpulse
# Optional: comma-separated DNS servers for mongodb+srv lookups (only if Node cannot resolve SRV records on your machine).
# DNS_SERVERS=8.8.8.8,1.1.1.1
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"  (32+ chars; production refuses placeholders)
AUTH_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:3000
PORT=3000

# --- Email (Nodemailer over SMTP). Leave SMTP_HOST empty in development to log emails to the console. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="WorkPulse <no-reply@workpulse.local>"

# --- File storage: ImageKit (dashboard -> Developer options). ---
# Required for logos and attachments. Files are uploaded as private files and served via signed URLs.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
MAX_UPLOAD_MB=10

# --- Seeded super admin ---
SUPERADMIN_EMAIL=superadmin@workpulse.local
# Seeded platform owner. Use a strong unique password (12+ chars); production refuses the default.
SUPERADMIN_PASSWORD=SuperAdmin@123

# --- Phase 6 (optional) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret configured in the Razorpay dashboard (used to verify POST /api/billing/webhook)
RAZORPAY_WEBHOOK_SECRET=

# --- Android app (TWA) - only needed once the Play package exists (see README "Android app") ---
ANDROID_PACKAGE_NAME=
ANDROID_CERT_SHA256=
